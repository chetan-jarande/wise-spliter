{
  "name": "wise-spliter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 4173",
    "dev:api": "bun run src/server/index.ts",
    "api": "bun run src/server/index.ts",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit && node scripts/check-deprecations.mjs",
    "agents:check": "node agents/orchestrate-personas.mjs --phase check",
    "agents:verify": "node agents/orchestrate-personas.mjs --phase all",
    "apk": "bash scripts/build-apk.sh",
    "cap:sync": "cap sync android",
    "migrate:up": "node scripts/apply-migration.mjs local",
    "migrate:remote": "node scripts/apply-migration.mjs remote",
    "migrate:sql": "node scripts/apply-migration.mjs remote --print-sql",
    "migrate:verify": "node scripts/apply-migration.mjs verify",
    "setup:dev": "bun run scripts/setup-dev-user.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.0.11",
    "jspdf": "^4.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.23.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
