# =============================================================================
# Wise-Spliter - Environment Variable Template
# =============================================================================
#   cp .env.example .env.development    # loaded by `make dev`
#   cp .env.example .env.production     # loaded by `make prod`
#
# Both per-mode files (.env.development, .env.production) are gitignored and
# must never be committed.
# Everything is server-only except `VITE_*`, which is inlined into the browser
# client bundle at build time and is therefore public by definition.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CENTRALIZED SUPABASE STACK & SCHEMA (Server-Only)
# -----------------------------------------------------------------------------
# Centralized Local Supabase stack (/home/chetan/projects/my-scripts/setup/dependencies)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
SUPABASE_SCHEMA=wise_spliter

# Server-only secret — full bypass of row-level security (never prefix with VITE_).
# Use the new-format `sb_secret_...` key for local/hosted Supabase.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# -----------------------------------------------------------------------------
# 2. BACKEND API SECURITY, SESSION SIGNING & CORS ALLOWLIST (Server-Only)
# -----------------------------------------------------------------------------
# Server-only HMAC-SHA256 secret signing session tokens (openssl rand -hex 32).
# Give GRANT_TOKEN_SECRET a different value in .env.development and .env.production.
GRANT_TOKEN_SECRET=wise_spliter_dev_hmac_secret_9f8e7d6c5b4a32109f8e7d6c5b4a3210

# Comma-separated CORS origin allowlist enforced by the Backend API Gatekeeper.
# Capacitor/Tauri native app origins (`capacitor://localhost`, `tauri://localhost`) are also supported.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Set to `true` ONLY when running behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Rate limiting configuration (fixed window; default 120 req/min per IP, plus strict /api/auth/login limiter)
# RATE_LIMIT_WINDOW_SEC=60
# API_RATE_LIMIT=120

# Optional: To enable "Continue with Google" against Centralized Local Supabase (:54321),
# set SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID and SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET in
# /home/chetan/projects/my-scripts/setup/dependencies/.env (redirect URI: http://127.0.0.1:54321/auth/v1/callback)
# and enable [auth.external.google] in /home/chetan/projects/my-scripts/setup/dependencies/supabase/config.toml.

# Ports for local Frontend (Vite) and Backend API Service
APP_PORT=4173
API_PORT=4174

# -----------------------------------------------------------------------------
# 3. BROWSER / CLIENT VARIABLES (`VITE_` prefix for `@supabase/supabase-js`)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_SUPABASE_SCHEMA=wise_spliter
VITE_API_BASE_URL=http://127.0.0.1:4174
