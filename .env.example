# =============================================================================
# Wise-Spliter - Environment Variable Template
# =============================================================================
#   cp .env.example .env.development    # loaded by `make dev`
#   cp .env.example .env.production     # loaded by `make prod`
#
# Both per-mode files (.env.development, .env.production) are gitignored and
# must never be committed.
# Everything is server-only except `VITE_*`, which is inlined into the browser
# client bundle at build time and is therefore public by definition.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CENTRALIZED SUPABASE STACK & SCHEMA (Server-Only)
# -----------------------------------------------------------------------------
# Absolute path of the centralized local Supabase CLI project (used by `make supabase-*`).
SUPABASE_DIR=/path/to/centralized/supabase/project
SUPABASE_URL=http://127.0.0.1:54321
# `make migrate-remote` only: postgres connection string of the hosted DB (session pooler). Leave the
# password out to be prompted by psql. Migrations are tracked in wise_spliter.schema_migrations.
# SUPABASE_DB_URL=postgresql://postgres.<ref>@<pooler-host>:5432/postgres
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
# Local Postgres password for `make migrate-up` / `make migrate-docker` host psql fallbacks (from `supabase status`).
SUPABASE_DB_PASSWORD=
SUPABASE_SCHEMA=wise_spliter

# Server-only secret: full bypass of row-level security (never prefix with VITE_).
# Use the new-format `sb_secret_...` key (local: `supabase status`; hosted: Dashboard -> API Keys).
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 2. BACKEND API SECURITY, SESSION SIGNING & CORS ALLOWLIST (Server-Only)
# -----------------------------------------------------------------------------
# Server-only HMAC-SHA256 secret signing session tokens (openssl rand -hex 32).
# Give GRANT_TOKEN_SECRET a different value in .env.development and .env.production.
GRANT_TOKEN_SECRET=

# Comma-separated CORS origin allowlist enforced by the Backend API Gatekeeper.
# Capacitor/Tauri native app origins (`capacitor://localhost`, `tauri://localhost`) are also supported.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Client IP source for rate limiting: `cloudflare` (CF-Connecting-IP), `true` (rightmost
# X-Forwarded-For hop, appended by your own proxy) or `false` (socket address).
# Local: false. Behind Pyrite's ingress (make deploy-pyrite): true. Behind Cloudflare: cloudflare,
# and ONLY if the origin accepts traffic from Cloudflare alone (firewall to Cloudflare IP ranges or
# authenticated origin pulls); otherwise anyone can send their own CF-Connecting-IP.
# With `false` behind a proxy every user shares the proxy's IP and one rate-limit bucket.
TRUST_PROXY=false

# Rate limiting configuration (fixed window; default 120 req/min per IP, plus strict /api/auth/login limiter)
# RATE_LIMIT_WINDOW_SEC=60
# API_RATE_LIMIT=120
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SEC=900
# RATE_LIMIT_DISABLED=false

# Optional API tuning
# API_HOST=127.0.0.1
# MAX_JSON_BODY_BYTES=262144
# RATE_LIMIT_MAX_KEYS=10000
# SESSION_MAX_LIFETIME_DAYS=30
# Session tokens carry aud=wise-spliter:<SESSION_AUDIENCE or NODE_ENV>; tokens from another environment are rejected.
# SESSION_AUDIENCE=production
# Numeric settings must be positive numbers; the API refuses to start otherwise.
# DISABLE_NATIVE_ORIGINS=false
# WISE_SPLITER_NO_AUTO_LISTEN=0

# Optional: To enable "Continue with Google" against Centralized Local Supabase,
# set SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID and SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET in
# $SUPABASE_DIR/.env (redirect URI: <SUPABASE_URL>/auth/v1/callback)
# and enable [auth.external.google] in $SUPABASE_DIR/supabase/config.toml.

# Ports for local Frontend (Vite) and Backend API Service
APP_PORT=4173
API_PORT=4174

# -----------------------------------------------------------------------------
# 3. BROWSER / CLIENT VARIABLES (`VITE_` prefix for `@supabase/supabase-js`)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Public `sb_publishable_...` key (local: `supabase status`). ANON_KEY is a legacy alias.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SCHEMA=wise_spliter
# Native APK builds need an https:// VITE_API_BASE_URL (Android blocks cleartext and mixed content).
VITE_API_BASE_URL=http://127.0.0.1:4174

# -----------------------------------------------------------------------------
# 4. LOCAL DEV, TESTS & DEPLOY TOOLING
# -----------------------------------------------------------------------------
# Password for the seeded dev users (`make setup-dev`), also used by unit + e2e tests.
DEV_USER_PASSWORD=
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome
# Image tag for `make deploy-pyrite` (default: random ttl.sh tag, expires in 24h).
# IMAGE_REF=
